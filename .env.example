# Node 24+, HTTPS reverse proxy in production. Generate a long, unique password.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_ORIGIN=https://isaacwilliam.no
ADMIN_PASSWORD=
# Persistent private directory, outside Git and public/
DATA_DIR=./runtime
# Set only after reviewing the privacy notice and testing submissions.
BOOKING_ENABLED=false
# Keep staging out of search engines. Switch only after approval.
ALLOW_INDEXING=false

# Client follow-up is by ordinary email. Private client links are optional and OFF.
CLIENT_PORTAL_ENABLED=false
# Leave OFF until Google Workspace has been authorised and delivery tested.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=post@isaacwilliam.no
BOOKING_EMAIL_TO=post@isaacwilliam.no
# Use a Google App Password if permitted with 2-Step Verification, not the normal password.
SMTP_APP_PASSWORD=
# Alternative: OAuth2 credentials, configured securely on the hosting server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternative: Workspace admin-approved IP relay, host smtp-relay.gmail.com.
SMTP_RELAY_IP_AUTH=false
